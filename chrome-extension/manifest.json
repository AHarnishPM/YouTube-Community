{
  "manifest_version": 3,
  "name": "YouTube Community",
  "version": "1.1.4",
  "description": "Shows timestamped YouTube comments over the video at the moment they refer to.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://youtube-community.ytcommunity.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "consent.js",
        "settings.js",
        "youtube.js",
        "overlay.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}