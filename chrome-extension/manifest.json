{
  "manifest_version": 3,
  "name": "YouTube Community",
  "version": "0.1.0",
  "description": "Extension for interacting with YouTube.",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
