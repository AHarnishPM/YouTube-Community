{
  "openapi": "3.1.0",
  "info": {
    "title": "Mikko Claim Detection",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/claims/detect": {
      "post": {
        "summary": "Detect Claims",
        "operationId": "detect_claims_v1_claims_detect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimResult": {
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "title": "Segment Id"
          },
          "video_id": {
            "type": "string",
            "minLength": 1,
            "title": "Video Id"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text"
          },
          "is_context_worthy": {
            "type": "boolean",
            "title": "Is Context Worthy"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "detector": {
            "type": "string",
            "title": "Detector"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segment_id",
          "video_id",
          "start",
          "end",
          "text",
          "is_context_worthy",
          "confidence",
          "reason",
          "detector",
          "threshold"
        ],
        "title": "ClaimResult"
      },
      "DetectRequest": {
        "properties": {
          "segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentInput"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Segments"
          },
          "detector": {
            "type": "string",
            "enum": [
              "rules",
              "ollama"
            ],
            "title": "Detector",
            "default": "rules"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segments"
        ],
        "title": "DetectRequest"
      },
      "DetectResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/ClaimResult"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "type": "object",
        "required": [
          "predictions"
        ],
        "title": "DetectResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SegmentInput": {
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "title": "Segment Id"
          },
          "video_id": {
            "type": "string",
            "minLength": 1,
            "title": "Video Id"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segment_id",
          "video_id",
          "start",
          "end",
          "text"
        ],
        "title": "SegmentInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
